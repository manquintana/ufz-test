{
  "name": "ufz/api-base",
  "version": "1.0.0",
  "description": "UFZ library for basic API functionalities",
  "type": "library",
  "license": "GPL-3.0-only",
  "authors": [
    {
      "name": "InfAI",
      "email": "jovanovic@infai.org"
    }
  ],
  "autoload": {
    "psr-4": {
      "Ufz\\ApiBase\\": "src/",
      "Ufz\\ApiBase\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "~8.3",
    "ext-json": "*",
    "api-platform/symfony": "^4.2",
    "aws/aws-sdk-php": "^3.288",
    "codercat/jwk-to-pem": "0.0.3 || ^1",
    "doctrine/orm": "^2.6.4 || ^3.0",
    "guzzlehttp/guzzle": "^7.4",
    "imagine/imagine": "^1.3",
    "laminas/laminas-code": "^4.14",
    "league/flysystem-aws-s3-v3": "^3.0",
    "league/flysystem-bundle": "^3.0",
    "lexik/jwt-authentication-bundle": "^2.21",
    "lcobucci/jwt": "^5.1",
    "lcobucci/clock": "^3.2",
    "open-telemetry/exporter-otlp": "^1.0",
    "open-telemetry/sdk": "^1.0",
    "symfony/asset": "^7.0",
    "symfony/cache": "^7.0",
    "symfony/console": "^7.0",
    "symfony/config": "^7.0",
    "symfony/dependency-injection": "^7.0",
    "symfony/doctrine-bridge": "^7.0",
    "symfony/expression-language": "^7.0",
    "symfony/event-dispatcher": "^7.0",
    "symfony/error-handler": "^7.0",
    "symfony/filesystem": "^7.0",
    "symfony/finder": "^7.0",
    "symfony/framework-bundle": "^7.0",
    "symfony/http-foundation": "^7.0",
    "symfony/http-kernel": "^7.0",
    "symfony/mime": "^7.0",
    "symfony/options-resolver": "^7.0",
    "symfony/orm-pack": "^2",
    "symfony/password-hasher": "^7.0",
    "symfony/property-access": "^7.0",
    "symfony/property-info": "^7.0",
    "symfony/routing": "^7.0",
    "symfony/security-bundle": "^7.0",
    "symfony/security-core": "^7.0",
    "symfony/security-csrf": "^7.0",
    "symfony/serializer": "^7.0",
    "symfony/stopwatch": "^7.0",
    "symfony/string": "^7.0",
    "symfony/twig-bridge": "^7.0",
    "symfony/twig-bundle": "^7.0",
    "symfony/validator": "^7.0",
    "symfony/var-dumper": "^7.0",
    "symfony/var-exporter": "^7.0",
    "symfony/web-link": "^7.0",
    "vich/uploader-bundle": "^2.0",
    "symfony/http-client": "^7.0"
  },
  "require-dev": {
    "api-platform/doctrine-orm": "^4.2",
    "api-platform/graphql": "^4.2",
    "phpunit/phpunit": "^10.5",
    "rector/rector": "^0.14.4",
    "ufz/api-core": "*"
  },
  "config": {
    "allow-plugins": {
      "cs278/composer-audit": true,
      "php-http/discovery": true,
      "tbachert/spi": true
    },
    "audit": {
      "ignore":[]
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "../api-core"
    },
    {
      "type": "composer",
      "url": "https://packagist.org"
    },
    { "packagist": false }
  ]
}
